generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SECURITY
  RECEPTIONIST
  STAFF
  DEPARTMENT_HEAD
}

enum AppointmentStatus {
  PENDING
  APPROVED
  DECLINED
  RESCHEDULED
  CANCELLED
  ARRIVED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  COMPLETED
}

enum VisitorLogStatus {
  CHECKED_IN
  CHECKED_OUT
}

enum WalkInDecision {
  PENDING
  APPROVED
  DECLINED
  WAIT
  RESCHEDULED
}

enum NotificationType {
  EMAIL
  SMS
  IN_APP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum IDType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  VOTER_ID
  COMPANY_ID
  OTHER
}

enum VisitorType {
  GUEST
  CONTRACTOR
  VENDOR
  DELIVERY
  VIP
  STAFF_GUEST
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum DocumentType {
  INVITATION_LETTER
  ID_DOCUMENT
  WORK_PERMIT
  SAFETY_INDUCTION
  DELIVERY_NOTE
  CONTRACT
  OTHER
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum AccessAction {
  GRANT
  REVOKE
  ENTRY
  EXIT
}

enum KioskStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

// ==================== MODELS ====================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  departmentId  String?
  branchId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  department    Department?    @relation(fields: [departmentId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  staffProfile  StaffProfile?
  appointments  Appointment[]  @relation("AppointmentRecipient")
  walkInRequests WalkInRequest[] @relation("WalkInRecipient")
  chatMessages  ChatMessage[]
  directMessagesSent DirectMessage[] @relation("DirectMessageSender")
  directMessagesReceived DirectMessage[] @relation("DirectMessageRecipient")
  conversationsAsUser1 Conversation[] @relation("ConvoUser1")
  conversationsAsUser2 Conversation[] @relation("ConvoUser2")
  notifications Notification[]
  auditLogs     AuditLog[]
  calendarIntegrations CalendarIntegration[]
  sessions      Session[]
  accounts      Account[]

  @@index([email])
  @@index([role])
  @@index([departmentId])
  @@index([branchId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       User[]
  appointments Appointment[]
}

model Branch {
  id          String    @id @default(uuid())
  name        String    @unique
  address     String?
  city        String?
  phone       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users        User[]
  appointments Appointment[]
  visitorLogs  VisitorLog[]
  meetingRooms MeetingRoom[]
}

model StaffProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  title       String?
  office      String?
  extension   String?
  bio         String?
  availability String? // JSON string for availability schedule

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Visitor {
  id              String      @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String
  company         String?
  visitorType     VisitorType @default(GUEST)
  idType          IDType?
  idNumber        String?     // Masked ID number
  idDocumentUrl   String?     // Uploaded ID document
  idVerified      Boolean     @default(false)
  vehicleNumber   String?
  photo           String?     // Captured photo URL
  isBlacklisted   Boolean     @default(false)
  // Contractor/vendor fields
  accessExpiry    DateTime?
  safetyInduction Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appointments   Appointment[]
  visitorLogs    VisitorLog[]
  walkInRequests WalkInRequest[]
  documents      VisitorDocument[]
  watchlistEntries WatchlistEntry[]
  consentRecords ConsentRecord[]

  @@index([phone])
  @@index([email])
  @@index([isBlacklisted])
  @@index([visitorType])
}

model Appointment {
  id              String            @id @default(uuid())
  appointmentCode String            @unique
  qrCodeToken     String            @unique @default(uuid())
  qrExpiresAt     DateTime?         // QR expires after appointment window
  visitorId       String
  recipientId     String
  departmentId    String?
  branchId        String?
  roomId          String?           // Meeting room booking
  purpose         String
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  declineReason   String?
  rescheduledDate DateTime?
  rescheduledTime DateTime?
  googleEventId   String?
  outlookEventId  String?
  reminderSent    Boolean           @default(false)
  // Waiting time tracking
  arrivedAt       DateTime?
  respondedAt     DateTime?         // When host responded
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  visitor         Visitor           @relation(fields: [visitorId], references: [id])
  recipient       User              @relation("AppointmentRecipient", fields: [recipientId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])
  branch          Branch?           @relation(fields: [branchId], references: [id])
  room            MeetingRoom?      @relation(fields: [roomId], references: [id])
  visitorLog      VisitorLog?
  roomBooking     RoomBooking?

  @@index([appointmentCode])
  @@index([qrCodeToken])
  @@index([status])
  @@index([date])
  @@index([recipientId])
  @@index([visitorId])
  @@index([roomId])
}

model VisitorLog {
  id            String          @id @default(uuid())
  visitorId     String
  appointmentId String?         @unique
  branchId      String?
  purpose       String
  recipientName String?
  hostId        String?
  status        VisitorLogStatus @default(CHECKED_IN)
  checkInTime   DateTime        @default(now())
  checkOutTime  DateTime?
  badgeNumber   String?
  photoUrl      String?         // Photo taken at check-in
  isWalkIn      Boolean         @default(false)
  notes         String?
  checkedInBy   String?
  checkedOutBy  String?
  // Emergency roll call
  isAccountedFor Boolean        @default(false)
  accountedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  visitor       Visitor         @relation(fields: [visitorId], references: [id])
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  branch        Branch?         @relation(fields: [branchId], references: [id])

  @@index([visitorId])
  @@index([status])
  @@index([checkInTime])
  @@index([isWalkIn])
  @@index([branchId])
  @@index([hostId])
}

model WalkInRequest {
  id            String        @id @default(uuid())
  visitorId     String
  recipientId   String
  purpose       String
  decision      WalkInDecision @default(PENDING)
  decisionNote  String?
  respondedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  visitor       Visitor       @relation(fields: [visitorId], references: [id])
  recipient     User          @relation("WalkInRecipient", fields: [recipientId], references: [id])
  chatMessages  ChatMessage[]

  @@index([recipientId])
  @@index([decision])
  @@index([createdAt])
}

model ChatMessage {
  id            String    @id @default(uuid())
  walkInRequestId String
  senderId      String
  message       String
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  walkInRequest WalkInRequest @relation(fields: [walkInRequestId], references: [id])
  sender        User          @relation(fields: [senderId], references: [id])

  @@index([walkInRequestId])
  @@index([senderId])
}

model Conversation {
  id          String   @id @default(uuid())
  user1Id     String
  user2Id     String
  lastMessage String?
  lastAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user1    User             @relation("ConvoUser1", fields: [user1Id], references: [id])
  user2    User             @relation("ConvoUser2", fields: [user2Id], references: [id])
  messages DirectMessage[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastAt])
}

model DirectMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  recipientId    String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("DirectMessageSender", fields: [senderId], references: [id])
  recipient    User         @relation("DirectMessageRecipient", fields: [recipientId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  title     String
  message   String
  link      String?
  metadata  String?            // JSON string for additional data
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user      User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model CalendarIntegration {
  id            String   @id @default(uuid())
  userId        String
  provider      String   // google, apple
  accessToken   String?  @db.Text
  refreshToken  String?  @db.Text
  expiresAt     DateTime?
  calendarId    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues String?  @db.Text // JSON
  newValues String?  @db.Text // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ==================== PRO FEATURE MODELS ====================

model WatchlistEntry {
  id          String    @id @default(uuid())
  visitorId   String?
  firstName   String?
  lastName    String?
  phone       String?
  email       String?
  idNumber    String?
  riskLevel   RiskLevel @default(MEDIUM)
  reason      String
  notes       String?   @db.Text
  isActive    Boolean   @default(true)
  addedBy     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visitor     Visitor?  @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([phone])
  @@index([email])
  @@index([idNumber])
  @@index([riskLevel])
  @@index([isActive])
}

model VisitorDocument {
  id          String       @id @default(uuid())
  visitorId   String
  type        DocumentType
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedBy  String?
  isVerified  Boolean      @default(false)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  visitor     Visitor      @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([type])
}

model MeetingRoom {
  id          String     @id @default(uuid())
  name        String
  branchId    String?
  floor       String?
  capacity    Int        @default(4)
  amenities   String?    // JSON: ["projector","whiteboard","video_conferencing"]
  status      RoomStatus @default(AVAILABLE)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  branch      Branch?    @relation(fields: [branchId], references: [id])
  bookings    RoomBooking[]
  appointments Appointment[]

  @@index([branchId])
  @@index([status])
}

model RoomBooking {
  id            String    @id @default(uuid())
  roomId        String
  appointmentId String?   @unique
  bookedBy      String
  title         String
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  room          MeetingRoom @relation(fields: [roomId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([roomId])
  @@index([date])
  @@index([bookedBy])
}

model KioskSession {
  id          String      @id @default(uuid())
  branchId    String?
  visitorPhone String?
  visitorName String?
  appointmentCode String?
  qrToken     String?
  status      KioskStatus @default(ACTIVE)
  deviceId    String?
  ipAddress   String?
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  @@index([branchId])
  @@index([visitorPhone])
  @@index([status])
  @@index([appointmentCode])
}

model ApprovalRule {
  id            String   @id @default(uuid())
  name          String
  description   String?
  // Conditions (JSON for flexibility)
  conditions    String   @db.Text // JSON: { visitorType, department, timeRange, visitCount }
  // Action
  action        String   // auto_approve, require_approval, block
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([priority])
}

model AccessControlDevice {
  id          String   @id @default(uuid())
  name        String
  type        String   // turnstile, smart_door, biometric
  location    String?
  branchId    String?
  ipAddress   String?
  apiEndpoint String?
  apiKey      String?
  isActive    Boolean  @default(true)
  lastPing    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        AccessControlLog[]

  @@index([branchId])
  @@index([type])
}

model AccessControlLog {
  id        String       @id @default(uuid())
  deviceId  String
  visitorId String?
  userId    String?
  action    AccessAction
  granted   Boolean      @default(true)
  reason    String?
  metadata  String?      @db.Text // JSON
  createdAt DateTime     @default(now())

  device    AccessControlDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([visitorId])
  @@index([action])
  @@index([createdAt])
}

model ConsentRecord {
  id          String        @id @default(uuid())
  visitorId   String
  consentType String        // data_processing, photo_capture, id_storage
  status      ConsentStatus @default(GRANTED)
  ipAddress   String?
  grantedAt   DateTime      @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime?

  visitor     Visitor       @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([consentType])
  @@index([status])
}

model DataRetentionPolicy {
  id              String   @id @default(uuid())
  entityType      String   // visitor_log, visitor_photo, documents
  retentionDays   Int      @default(365)
  action          String   // delete, anonymize
  isActive        Boolean  @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType])
}

// ==================== SAAS / MULTI-TENANT ====================

model Tenant {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  domain        String?  @unique
  logo          String?
  primaryColor  String?  @default("#3b82f6")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@index([slug])
  @@index([domain])
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  price         Float
  currency      String   @default("GHS")
  interval      String   @default("monthly") // monthly, yearly
  // Limits
  maxUsers      Int      @default(10)
  maxBranches   Int      @default(1)
  maxVisitors   Int      @default(500) // per month
  maxRooms      Int      @default(3)
  // Feature flags
  features      String   @db.Text // JSON array of feature keys
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id            String             @id @default(uuid())
  tenantId      String
  planId        String
  status        SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt   DateTime?
  cancelledAt   DateTime?
  // Usage tracking
  usersCount    Int    @default(0)
  visitorsThisMonth Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
}
