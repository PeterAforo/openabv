# Database (add ?pgbouncer=true&connect_timeout=15 for Neon pooled connections)
DATABASE_URL="postgresql://user:password@localhost:5432/openabv?schema=public&connect_timeout=15"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-auth-secret-here"

# Google OAuth & Calendar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# mNotify SMS
MNOTIFY_API_KEY=""
MNOTIFY_SENDER_ID="OpenABV"

# Email / SMTP
EMAIL_FROM="noreply@openabv.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Pusher (Real-time)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# App
APP_URL="http://localhost:3000"

# Cron (used to secure /api/reminders endpoint)
CRON_SECRET="your-cron-secret-here"
